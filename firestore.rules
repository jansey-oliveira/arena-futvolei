rules_version = '2';

// Regras de segurança do Arena Futvôlei.
// Cole este arquivo inteiro em: Console do Firebase > Firestore Database > Regras > Publicar.
//
// Quem pode o quê:
// - Qualquer pessoa: ver torneios, jogos, classificação e chaves (sem login).
// - Organizadores: e-mails cadastrados na coleção "admins" (um documento por e-mail). Podem tudo.
// - Mesários: quem abriu o link secreto do torneio. Só alteram placar e andamento dos jogos.
// - Atletas: podem enviar inscrição. Só os organizadores leem as inscrições (têm telefone).

service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && request.auth.token.email != null
        && request.auth.token.email_verified == true
        && exists(/databases/$(database)/documents/admins/$(request.auth.token.email));
    }

    // Lista de organizadores: só se cria pelo Console do Firebase.
    match /admins/{email} {
      allow read: if request.auth != null && request.auth.token.email == email;
      allow write: if false;
    }

    match /torneios/{tid} {
      allow read: if true;
      allow write: if isAdmin();

      function tokenAtual() {
        return get(/databases/$(database)/documents/torneios/$(tid)/privado/config).data.mesarioToken;
      }
      function isMesario() {
        return request.auth != null
          && exists(/databases/$(database)/documents/torneios/$(tid)/mesarios/$(request.auth.uid))
          && get(/databases/$(database)/documents/torneios/$(tid)/mesarios/$(request.auth.uid)).data.token == tokenAtual();
      }

      match /jogos/{jid} {
        allow read: if true;
        allow create, delete: if isAdmin();
        allow update: if isAdmin()
          || (isMesario()
              && request.resource.data.diff(resource.data).affectedKeys()
                   .hasOnly(['pa', 'pb', 'status', 'quadra', 'inicio', 'fim', 'vencedor', 'a', 'b', 'sets']));
      }

      // Guarda o código secreto do link de mesário.
      match /privado/{docId} {
        allow read, write: if isAdmin();
      }

      // Cada aparelho que abriu o link de mesário.
      match /mesarios/{uid} {
        allow read: if isAdmin() || (request.auth != null && request.auth.uid == uid);
        allow create, update: if request.auth != null
          && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['token', 'em'])
          && request.resource.data.token == tokenAtual();
        allow delete: if isAdmin();
      }

      match /inscricoes/{iid} {
        allow read, update, delete: if isAdmin();
        allow create: if request.auth != null
          && request.resource.data.keys().hasOnly(['cat', 'j1', 'j2', 'zap', 'status', 'em', 'uid', 'comprovante'])
          && request.resource.data.status == 'pendente'
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.cat is string && request.resource.data.cat.size() <= 40
          && request.resource.data.j1 is string && request.resource.data.j1.size() <= 60
          && request.resource.data.j2 is string && request.resource.data.j2.size() <= 60
          && request.resource.data.zap is string && request.resource.data.zap.size() <= 30;
      }

      // Foto do comprovante do Pix (só o organizador vê).
      match /comprovantes/{iid} {
        allow read, delete: if isAdmin();
        allow create: if request.auth != null
          && request.resource.data.keys().hasOnly(['uid', 'img', 'em'])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.img is string
          && request.resource.data.img.size() < 900000;
      }

      // Patrocinadores (logo, frase e link do QR code), visíveis a todos.
      match /patrocinadores/{pid} {
        allow read: if true;
        allow write: if isAdmin();
      }
    }
  }
}

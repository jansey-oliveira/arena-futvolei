rules_version = '2';

// Regras de segurança do Arena Futvôlei.
// Cole este arquivo inteiro em: Console do Firebase > Firestore Database > Regras > Publicar.
//
// Quem pode o quê:
// - Qualquer pessoa: ver torneios, jogos, classificação e chaves (sem login).
// - Administradores: e-mails cadastrados na coleção "admins" (um documento por e-mail). Podem tudo,
//   inclusive criar e apagar torneios.
// - Organizadores de um torneio: e-mails em torneios/{id}/organizadores. Editam só aquele torneio.
// - Mesários: quem abriu o link secreto do torneio. Só alteram placar e andamento dos jogos.
// - Atletas: podem enviar inscrição. Só os organizadores leem as inscrições (têm telefone).

service cloud.firestore {
  match /databases/{database}/documents {

    function emailOk() {
      return request.auth != null
        && request.auth.token.email != null
        && request.auth.token.email_verified == true;
    }
    function isAdmin() {
      return emailOk()
        && exists(/databases/$(database)/documents/admins/$(request.auth.token.email));
    }

    // Lista de administradores: só se cria pelo Console do Firebase.
    match /admins/{email} {
      allow read: if request.auth != null && request.auth.token.email == email;
      allow write: if false;
    }

    match /torneios/{tid} {
      allow read: if true;
      allow create, delete: if isAdmin();
      allow update: if isOrg();

      // Administrador ou organizador deste torneio.
      function isOrg() {
        return isAdmin()
          || (emailOk() && exists(/databases/$(database)/documents/torneios/$(tid)/organizadores/$(request.auth.token.email.lower())));
      }

      function tokenAtual() {
        return get(/databases/$(database)/documents/torneios/$(tid)/privado/config).data.mesarioToken;
      }
      function isMesario() {
        return request.auth != null
          && exists(/databases/$(database)/documents/torneios/$(tid)/mesarios/$(request.auth.uid))
          && get(/databases/$(database)/documents/torneios/$(tid)/mesarios/$(request.auth.uid)).data.token == tokenAtual();
      }

      match /jogos/{jid} {
        allow read: if true;
        allow create, delete: if isOrg();
        allow update: if isOrg()
          || (isMesario()
              && request.resource.data.diff(resource.data).affectedKeys()
                   .hasOnly(['pa', 'pb', 'status', 'quadra', 'inicio', 'fim', 'vencedor', 'a', 'b', 'sets', 'log', 'wo']));
      }

      // Guarda o código secreto do link de mesário.
      match /privado/{docId} {
        allow read, write: if isOrg();
      }

      // Organizadores deste torneio (ID do documento = e-mail em minúsculas).
      // Cada organizador pode adicionar e remover outros do mesmo torneio.
      match /organizadores/{email} {
        allow read: if isOrg() || (emailOk() && request.auth.token.email.lower() == email);
        allow create, update: if isOrg()
          && email == email.lower()
          && request.resource.data.keys().hasOnly(['nome', 'em', 'por'])
          && request.resource.data.get('nome', '') is string && request.resource.data.get('nome', '').size() <= 60;
        allow delete: if isOrg();
      }

      // Cada aparelho que abriu o link de mesário.
      match /mesarios/{uid} {
        allow read: if isOrg() || (request.auth != null && request.auth.uid == uid);
        allow create, update: if request.auth != null
          && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['token', 'em'])
          && request.resource.data.token == tokenAtual();
        allow delete: if isOrg();
      }

      // Campo de texto opcional com tamanho máximo.
      function texto(campo, max) {
        return request.resource.data.get(campo, '') is string && request.resource.data.get(campo, '').size() <= max;
      }

      // Contador de inscrições por aparelho (limite de 5 por torneio, contra envio em massa).
      function limite() {
        return /databases/$(database)/documents/torneios/$(tid)/limites/$(request.auth.uid);
      }
      match /limites/{u} {
        allow read: if isOrg() || (request.auth != null && request.auth.uid == u);
        allow create: if request.auth != null && request.auth.uid == u
          && request.resource.data.keys().hasOnly(['n']) && request.resource.data.n == 1;
        allow update: if request.auth != null && request.auth.uid == u
          && request.resource.data.keys().hasOnly(['n']) && request.resource.data.n == resource.data.n + 1
          && request.resource.data.n <= 5;
        allow delete: if isOrg();
      }

      match /inscricoes/{iid} {
        allow list, update, delete: if isOrg();
        // O atleta consegue ver a situação da própria inscrição (feita neste aparelho).
        allow get: if isOrg() || (request.auth != null && resource.data.uid == request.auth.uid);
        allow create: if request.auth != null
          && get(/databases/$(database)/documents/torneios/$(tid)).data.get('inscricoes', false) == true
          && (get(/databases/$(database)/documents/torneios/$(tid)).data.get('inscAte', 0) == 0
              || request.time.toMillis() < get(/databases/$(database)/documents/torneios/$(tid)).data.get('inscAte', 0))
          && ((!exists(limite()) && getAfter(limite()).data.n == 1)
              || (exists(limite()) && getAfter(limite()).data.n == get(limite()).data.n + 1))
          && request.resource.data.keys().hasOnly(['cat', 'j1', 'j2', 'zap', 'status', 'em', 'uid', 'comprovante',
               'resp', 'email', 'ig1', 'ig2', 'uni1', 'uni2', 'nomeDupla', 'extras', 'aceites', 'valor', 'cupom'])
          && request.resource.data.status in ['pendente', 'espera']
          && request.resource.data.get('valor', 0) is number && request.resource.data.get('valor', 0) >= 0
          && texto('cupom', 30)
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.cat is string && request.resource.data.cat.size() <= 40
          && request.resource.data.j1 is string && request.resource.data.j1.size() <= 60
          && request.resource.data.j2 is string && request.resource.data.j2.size() <= 60
          && request.resource.data.zap is string && request.resource.data.zap.size() <= 30
          && texto('resp', 60) && texto('email', 80) && texto('nomeDupla', 60)
          && texto('ig1', 40) && texto('ig2', 40) && texto('uni1', 30) && texto('uni2', 30)
          && request.resource.data.get('extras', {}) is map && request.resource.data.get('extras', {}).size() <= 30
          && request.resource.data.get('aceites', []) is list && request.resource.data.get('aceites', []).size() <= 30;
      }

      // Foto do comprovante do Pix (só o organizador vê).
      match /comprovantes/{iid} {
        allow read, delete: if isOrg();
        allow create: if request.auth != null
          && request.resource.data.keys().hasOnly(['uid', 'img', 'em'])
          && request.resource.data.uid == request.auth.uid
          && getAfter(/databases/$(database)/documents/torneios/$(tid)/inscricoes/$(iid)).data.uid == request.auth.uid
          && request.resource.data.img is string
          && request.resource.data.img.size() < 900000;
      }

      // Patrocinadores (logo, frase e link do QR code), visíveis a todos.
      match /patrocinadores/{pid} {
        allow read: if true;
        allow write: if isOrg();
      }
    }
  }
}
